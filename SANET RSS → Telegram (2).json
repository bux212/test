{
  "name": "SANET RSS → Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "dcb964a9-ce6d-4298-a27f-0eef5252018a",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "scrape",
        "url": "https://sanet.st/video-courses/rss",
        "scrapeOptions": {
          "options": {
            "formats": {
              "format": [
                {
                  "type": "rawHtml"
                }
              ]
            },
            "headers": {}
          }
        },
        "requestOptions": {}
      },
      "id": "29933257-0377-47d4-895c-cbf7a2605d98",
      "name": "Fetch RSS",
      "type": "@mendable/n8n-nodes-firecrawl.firecrawl",
      "typeVersion": 1,
      "position": [
        224,
        0
      ],
      "credentials": {
        "firecrawlApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const d = j.data || {};\n  const xml = j.rawHtml || j.html || d.rawHtml || d.html || j.markdown || d.markdown || '';\n  out.push({ json: { data: xml } });\n}\nreturn out;"
      },
      "id": "4323614e-34ff-460a-979f-6841c9d85866",
      "name": "Extract Feed XML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "options": {
          "explicitArray": false,
          "mergeAttrs": true
        }
      },
      "id": "2cad7ef5-093b-4845-88e3-b0ffb8684aa4",
      "name": "Parse XML",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "rss.channel.item",
        "options": {}
      },
      "id": "6435c419-8caa-450e-b1b8-58488cc21d59",
      "name": "Split Feed Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $input.item.json;\nconst desc = typeof j.description === 'string' ? j.description : (j.description && j.description._) || '';\nconst m = desc.match(/<img[^>]+src=[\"\\']([^\"\\']+)[\"\\']/i);\nconst link = typeof j.link === 'string' ? j.link : (j.link && j.link._) || j.guid || '';\nconst title = typeof j.title === 'string' ? j.title : (j.title && j.title._) || '';\nconst rawImg = m ? m[1] : '';\n// SANET thumbnails are AVIF, which Telegram sendPhoto cannot fetch by URL.\n// Route through an image proxy that converts to JPEG on the fly.\nj.imageUrl = rawImg ? 'https://images.weserv.nl/?url=' + encodeURIComponent(rawImg) + '&output=jpg' : '';\nj.postLink = link;\nj.postTitle = title;\n// Extract lecture duration and file size from the description HTML.\n// Match on raw HTML so a following tag (e.g. </p>) bounds the value.\nconst durM = desc.match(/Duration:\\s*([^|<\\n]+)/i);\nconst sizeM = desc.match(/Size:\\s*([^|<\\n]+)/i);\nconst duration = durM ? durM[1].trim() : '';\nconst size = sizeM ? sizeM[1].trim() : '';\nj.duration = duration;\nj.size = size;\nconst metaParts = [];\nif (duration) metaParts.push('⏱ ' + duration);\nif (size) metaParts.push('💾 ' + size);\nj.meta = metaParts.join('   •   ');\n// Extract the category slug that follows /video-courses/ in the post URL.\nconst secM = link.match(/\\/video-courses\\/([^\\/]+)\\//i);\nj.section = secM ? secM[1] : '';\nreturn $input.item;"
      },
      "id": "017f6b3f-55d8-4e84-a663-b8b745ddf3d5",
      "name": "Extract Image & Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "img-not-empty",
              "leftValue": "={{ $json.imageUrl }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fe1ddd14-f2fe-4727-8a61-649632745dee",
      "name": "Has Image",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        1120,
        0
      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.postLink }}",
        "options": {
          "scope": "node",
          "historySize": 10000
        }
      },
      "id": "ac1c339b-25d9-40d7-96d8-71162bdb2ba3",
      "name": "Only New Posts",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "-1001104374505",
        "file": "={{ $json.imageUrl }}",
        "additionalFields": {
          "caption": "=🎓 <b>{{ $json.postTitle }}</b>\n\n<blockquote>{{ $json.meta }}</blockquote>\n📂 {{ $json.section }}\n\n🔗 <a href=\"{{ $json.postLink }}\">Открыть курс на SANET</a>",
          "parse_mode": "HTML"
        }
      },
      "id": "1a744a0a-04b9-4b12-8aa3-7b8961cf7769",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1568,
        0
      ],
      "webhookId": "2e1365bd-df42-47ad-a588-15bdb15fc4e0",
      "credentials": {
        "telegramApi": {
          "id": "O2rU4UUEEfT2Q8q2",
          "name": "Telegram Alarm"
        }
      }
    },
    {
      "parameters": {
        "amount": 2
      },
      "id": "77326688-68ec-4dab-ab65-50802bdb6038",
      "name": "Throttle 2s",
