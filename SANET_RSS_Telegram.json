      ]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.postLink }}",
        "options": {
          "scope": "node",
          "historySize": 10000
        }
      },
      "id": "4a26914c-023c-4f15-82e2-238d8b9a4af8",
      "name": "Only New Posts",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
