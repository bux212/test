      ]
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "-1001104374505",
        "file": "={{ $json.imageUrl }}",
        "additionalFields": {
          "caption": "=🎓 <b>{{ $json.postTitle }}</b>\n\n<blockquote>{{ $json.meta }}</blockquote>\n📂 {{ $json.section }}\n\n🔗 <a href=\"{{ $json.postLink }}\">Открыть курс на SANET</a>",
          "parse_mode": "HTML"
        }
      },
      "id": "f2bb5c29-fbbf-456f-9d0b-21b92c6b541e",
