              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "4e3e98ba-1266-47ae-83ff-79afa979a3c4",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
