      ]
    },
    {
      "parameters": {
        "operation": "scrape",
        "url": "https://sanet.st/video-courses/rss",
        "scrapeOptions": {
          "options": {
            "formats": {
              "format": [
                {
                  "type": "rawHtml"
                }
              ]
            },
            "headers": {}
          }
        },
        "requestOptions": {}
      },
      "id": "9738444b-d4b7-4c26-8e75-a299ca3b55d3",
      "name": "Fetch RSS",
      "type": "@mendable/n8n-nodes-firecrawl.firecrawl",
      "typeVersion": 1,
      "position": [
        224,
        0
      ],
      "credentials": {
        "firecrawlApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const d = j.data || {};\n  const xml = j.rawHtml || j.html || d.rawHtml || d.html || j.markdown || d.markdown || '';\n  out.push({ json: { data: xml } });\n}\nreturn out;"
      },
      "id": "0fd39733-abbc-4ca8-aa79-d88b2ed4fada",
      "name": "Extract Feed XML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "options": {
          "explicitArray": false,
          "mergeAttrs": true
        }
      },
      "id": "0af90057-a599-4099-8937-f1384fdd024e",
      "name": "Parse XML",
      "type": "n8n-nodes-base.xml",
      "typeVersion": 1,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "rss.channel.item",
        "options": {}
      },
      "id": "aebc70f7-5453-43b9-bcc2-56eb1871db66",
      "name": "Split Feed Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $input.item.json;\nconst desc = typeof j.description === 'string' ? j.description : (j.description && j.description._) || '';\nconst m = desc.match(/<img[^>]+src=[\"\\']([^\"\\']+)[\"\\']/i);\nconst link = typeof j.link === 'string' ? j.link : (j.link && j.link._) || j.guid || '';\nconst title = typeof j.title === 'string' ? j.title : (j.title && j.title._) || '';\nconst rawImg = m ? m[1] : '';\n// SANET thumbnails are AVIF, which Telegram sendPhoto cannot fetch by URL.\n// Route through an image proxy that converts to JPEG on the fly.\nj.imageUrl = rawImg ? 'https://images.weserv.nl/?url=' + encodeURIComponent(rawImg) + '&output=jpg' : '';\nj.postLink = link;\nj.postTitle = title;\n// Extract lecture duration and file size from the description HTML.\n// Match on raw HTML so a following tag (e.g. </p>) bounds the value.\nconst durM = desc.match(/Duration:\\s*([^|<\\n]+)/i);\nconst sizeM = desc.match(/Size:\\s*([^|<\\n]+)/i);\nconst duration = durM ? durM[1].trim() : '';\nconst size = sizeM ? sizeM[1].trim() : '';\nj.duration = duration;\nj.size = size;\nconst metaParts = [];\nif (duration) metaParts.push('⏱ ' + duration);\nif (size) metaParts.push('💾 ' + size);\nj.meta = metaParts.join('   •   ');\n// Extract the category slug that follows /video-courses/ in the post URL.\nconst secM = link.match(/\\/video-courses\\/([^\\/]+)\\//i);\nj.section = secM ? secM[1] : '';\nreturn $input.item;"
      },
      "id": "5e5b88ef-3207-4522-86e7-3dddd6a6ad5b",
      "name": "Extract Image & Link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "img-not-empty",
              "leftValue": "={{ $json.imageUrl }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1571042f-cc69-4a20-812c-71975a6128fc",
      "name": "Has Image",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
